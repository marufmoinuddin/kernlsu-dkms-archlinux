[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = kernelsu-dkms

[Action]
Description = Scheduling the KernelSU integration with Waydroid...
When = PostTransaction
# Numbered after 70-dkms-install.hook and 30-systemd-daemon-reload-system.hook
# so the module is built and the units are known before this runs.
Depends = systemd
# alpm keeps only the last Exec line of a hook, so the steps live in a script.
Exec = /usr/lib/kernelsu-waydroid/post-install
