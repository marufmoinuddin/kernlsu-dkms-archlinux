#!/usr/bin/env python3
"""Print the signing certificate(s) of an APK: SHA-256 and byte length.

Parses the v2/v3 APK Signing Block and falls back to the v1 JAR signature.
Standard library only, so this works on a host with no Android SDK installed.

Usage:
    apkcert APK            print every distinct certificate found
    apkcert APK SHA256     print the size of the matching certificate only
"""

import base64
import hashlib
import os
import re
import struct
import subprocess
import sys
import tempfile
import zipfile

EOCD_SIG = b"PK\x05\x06"
BLOCK_MAGIC = b"APK Sig Block 42"
SCHEME_IDS = (0x7109871A, 0xF05368C0, 0x1B93AD61)  # v2, v3, v3.1
V1_SUFFIXES = (".RSA", ".DSA", ".EC")

# Smallest X.509 certificate we will consider; keeps random DER fragments in
# the signing block from being mistaken for a certificate.
MIN_CERT_LEN = 200


def u32(data, off):
    return struct.unpack_from("<I", data, off)[0], off + 4


def u64(data, off):
    return struct.unpack_from("<Q", data, off)[0], off + 8


def der_is_certificate(der):
    """Cheap structural check that a blob is a plausible X.509 certificate."""
    if len(der) < MIN_CERT_LEN or der[0] != 0x30:
        return False
    if der[1] != 0x82:
        return False
    declared = struct.unpack_from(">H", der, 2)[0] + 4
    if declared != len(der):
        return False
    # tbsCertificate, signatureAlgorithm and signatureValue must be present.
    for oid in (b"\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01",   # sha256WithRSA
                b"\x06\x09\x2a\x86\x48\x86\xf7\x0d\x01\x01\x0b"):  # sha256WithRSAAndMGF1
        if oid in der:
            return True
    return b"\x55\x04" in der  # any X.501 attribute type


def signing_block(path):
    """Return the raw APK Signing Block contents, or None."""
    with open(path, "rb") as f:
        f.seek(0, 2)
        size = f.tell()
        if size < 32:
            return None

        # Locate the end of central directory record.
        window = min(size, 0x10000 + 22)
        f.seek(size - window)
        tail = f.read(window)
        eocd = tail.rfind(EOCD_SIG)
        if eocd < 0:
            return None
        cd_offset = struct.unpack_from("<I", tail, eocd + 16)[0]
        if cd_offset < 32 or cd_offset > size:
            return None

        # The block footer (u64 size + 16 byte magic) sits immediately before
        # the central directory.
        f.seek(cd_offset - 24)
        block_size, magic = struct.unpack("<Q16s", f.read(24))
        if magic != BLOCK_MAGIC:
            return None

        start = cd_offset - block_size - 8
        if start < 0:
            return None
        # block_size counts the pairs plus the trailing u64+magic.
        f.seek(start + 8)
        return f.read(block_size - 24)


def iter_pairs(block):
    off = 0
    while off + 12 <= len(block):
        pair_len, off = u64(block, off)
        pair_end = off + pair_len
        if pair_end > len(block) or pair_len < 4:
            return
        pair_id, off = u32(block, off)
        yield pair_id, block[off:pair_end]
        off = pair_end


def skip_digests(signer, pos):
    """Advance past the length-prefixed digest sequence."""
    length, pos = u32(signer, pos)
    return pos + length


def certificates_from(signed_data):
    """Read the certificate sequence out of a signer's signed data."""
    # apksigner wraps digests+certificates+attributes in its own length
    # prefix, so the section can start either at 0 or at 4.
    for base in (4, 0):
        if base + 4 > len(signed_data):
            continue
        try:
            pos = skip_digests(signed_data, base)
            certs_len, pos = u32(signed_data, pos)
            certs_end = pos + certs_len
            if certs_end > len(signed_data):
                continue
        except struct.error:
            continue

        certs = []
        good = certs_len >= 4
        while good and pos + 4 <= certs_end:
            try:
                length, pos = u32(signed_data, pos)
            except struct.error:
                good = False
                break
            if length == 0 or pos + length > certs_end:
                good = False
                break
            cert = signed_data[pos:pos + length]
            if not der_is_certificate(cert):
                good = False
                break
            certs.append(cert)
            pos += length
        if good and certs and pos == certs_end:
            return certs
    return []


def from_signing_block(path):
    block = signing_block(path)
    if block is None:
        return []

    certs = []
    for pair_id, value in iter_pairs(block):
        if pair_id not in SCHEME_IDS or len(value) < 8:
            continue
        # uint32-prefixed sequence of signers.
        signers_len, off = u32(value, 0)
        if signers_len + 4 > len(value):
            continue
        end = min(4 + signers_len, len(value))
        while off + 4 <= end:
            signer_len, off = u32(value, off)
            if signer_len == 0 or off + signer_len > end:
                break
            signer = value[off:off + signer_len]
            off += signer_len

            # The signer may or may not carry the apksigner wrapper.
            for skip in (0, 4):
                found = certificates_from(signer[skip:])
                if found:
                    certs.extend(found)
                    break
    return certs


def from_jar_signature(path):
    with zipfile.ZipFile(path) as archive:
        names = [
            n for n in archive.namelist()
            if n.upper().startswith("META-INF/")
            and n.upper().endswith(V1_SUFFIXES)
        ]
        if not names:
            return []
        blob = archive.read(sorted(names)[0])

    with tempfile.NamedTemporaryFile(suffix=".RSA", delete=False) as tmp:
        tmp.write(blob)
        tmp_path = tmp.name
    try:
        pem = subprocess.run(
            ["keytool", "-printcert", "-rfc", "-file", tmp_path],
            capture_output=True, text=True,
        ).stdout
        body = "".join(l for l in pem.splitlines()
                       if l and not l.startswith("-----"))
        certs = []
        for match in re.finditer(
            r"-----BEGIN CERTIFICATE-----(.+?)-----END CERTIFICATE-----",
            pem, re.S,
        ):
            der = base64.b64decode("".join(match.group(1).split()))
            if der_is_certificate(der):
                certs.append(der)
        if not certs and body:
            certs.append(base64.b64decode(body))
        return certs
    except Exception:
        return []
    finally:
        os.unlink(tmp_path)


def collect(path):
    seen = []
    for cert in from_signing_block(path) + from_jar_signature(path):
        digest = hashlib.sha256(cert).hexdigest()
        if digest not in [d for d, _ in seen]:
            seen.append((digest, cert))
    return seen


def main():
    if len(sys.argv) not in (2, 3):
        print(__doc__.strip(), file=sys.stderr)
        return 2

    path = sys.argv[1]
    try:
        certs = collect(path)
    except (OSError, struct.error, zipfile.BadZipFile) as exc:
        print(f"apkcert: cannot read {path}: {exc}", file=sys.stderr)
        return 1

    if not certs:
        print(f"apkcert: no signing certificate found in {path}", file=sys.stderr)
        return 1

    if len(sys.argv) == 3:
        wanted = sys.argv[2].lower()
        for digest, cert in certs:
            if digest == wanted:
                print(f"size=0x{len(cert):04x}")
                return 0
        return 1

    for digest, cert in certs:
        print(f"sha256={digest}")
        print(f"size=0x{len(cert):04x}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
